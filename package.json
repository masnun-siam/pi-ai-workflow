{
  "name": "pi-ai-workflow",
  "version": "0.1.0",
  "description": "Deterministic routing engine that drives GitHub issues through an automated pipeline to reviewed PRs — Pi coding agent extension",
  "keywords": ["pi-package"],
  "type": "module",
  "main": "src/extension.ts",
  "pi": {
    "extensions": ["src/extension.ts"],
    "skills": ["skills"],
    "agents": ["agents"]
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
